# Copy this file to .env.local and fill in your Firebase web app config
# (Firebase console → Project settings → General → Your apps → Web app → Config).
# These values are not secret: firestore.rules controls who can read what.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# GEMINI_API_KEY: injected by AI Studio at runtime (not used by the app code).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: injected by AI Studio with the Cloud Run service URL.
APP_URL="MY_APP_URL"
